#!/bin/sh
# Keep a GitHub Codespace awake on a weekday/hour policy.
# POSIX sh — Linux, macOS, and anything with /bin/sh + gh.
set -eu

MARKER=codespaces-scheduled-keepalive
DEFAULT_CONFIG="${XDG_CONFIG_HOME:-$HOME/.config}/codespaces-keepalive/config"

cfg_timezone=UTC
cfg_minute=0
cfg_hours=7-17
cfg_weekdays=1-5
cfg_start_timeout_seconds=300
cfg_heartbeat_command=true
cfg_name=
cfg_log_dir=
cfg_debug=0
debug=0
log_file=

die() {
	line=$(printf '[%s] error: %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$*")
	append_log "$line"
	printf '%s' "$line" >&2
	exit 1
}

append_log() {
	[ -n "${log_file:-}" ] || return 0
	printf '%s' "$1" >>"$log_file"
}

log() {
	line=$(printf '[%s] %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$*")
	append_log "$line"
	if [ -t 1 ]; then
		printf '%s' "$line"
	fi
}

debug() {
	[ "${debug:-0}" = 1 ] || return 0
	log "debug: $*"
}

usage() {
	cat <<'EOF'
codespaces-keepalive — wake and keep a GitHub Codespace alive during work hours

Usage:
  codespaces-keepalive tick [--force] [--dry-run] [--debug] [--log-dir DIR] [--config PATH]
  codespaces-keepalive daemon [--dry-run] [--debug] [--log-dir DIR] [--config PATH]
  codespaces-keepalive status [--debug] [--log-dir DIR] [--config PATH]
  codespaces-keepalive install cron|systemd|launchd [--apply] [--debug] [--config PATH]
  codespaces-keepalive uninstall [cron|systemd|launchd] [--apply] [--config PATH]

tick       One-shot. Noop unless minute/hours/weekdays match now; otherwise start + heartbeat.
daemon     Loop every minute and call tick (for hosts without cron).
status     Print policy membership and the named codespace.
install    Print (or --apply) an OS timer that runs tick.
uninstall  Print (or --apply) removal of timers this tool installed. No target = all.
           Leaves config, logs, and the binary in place. Does not undo home-manager.

--debug, -d   Verbose logs (policy miss/match, gh calls, wait loops).
--log-dir DIR Override config log_dir for this run.

Logs go to log_dir/keepalive.log (config `log_dir`, default
$XDG_STATE_HOME/codespaces-keepalive). Cron/systemd/launchd are not ttys, so
without --debug those runs only write the log file (no mail/journal spam).

Policy (evaluated in `timezone`): `minute` (0-59), `hours` (* or 7-17),
`weekdays` (* or 1-5). 0=Sun ... 6=Sat. Defaults are weekday 07:00-17:00 hourly.

  install cron     writes a crontab from that policy (tick --force)
  systemd/launchd  wake every minute; tick noops unless the policy matches
EOF
}

script_path() {
	dir=$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd)
	printf '%s/%s\n' "$dir" "$(basename -- "$0")"
}

# Strip leading zeros so $((08)) is not parsed as invalid octal.
unpad() {
	n=$1
	while :; do
		case $n in
		0[0-9]*) n=${n#0} ;;
		*) break ;;
		esac
	done
	printf '%s\n' "${n:-0}"
}

is_int() {
	case $1 in
	'' | *[!0-9]*) return 1 ;;
	*) return 0 ;;
	esac
}

expand_path() {
	p=$1
	t='~'
	if [ "$p" = "$t" ]; then
		printf '%s\n' "$HOME"
	elif [ "${p#"$t"/}" != "$p" ]; then
		printf '%s/%s\n' "$HOME" "${p#"$t"/}"
	else
		printf '%s\n' "$p"
	fi
}

# Resolve --config and similar for timers whose cwd is not the install shell.
absolute_path() {
	p=$(expand_path "$1")
	case $p in
	/*) printf '%s\n' "$p" ;;
	*) printf '%s/%s\n' "$(pwd)" "$p" ;;
	esac
}

# Single-quote for crontab (runs through /bin/sh).
sh_quote() {
	printf "'"
	printf '%s' "$1" | sed "s/'/'\\\\''/g"
	printf "'"
}

xml_escape() {
	printf '%s' "$1" | sed -e 's/&/\&amp;/g' -e 's/</\&lt;/g' -e 's/>/\&gt;/g' -e 's/"/\&quot;/g'
}

validate_codespace_name() {
	case $1 in
	'' | . | .. | *[!A-Za-z0-9._-]*)
		die "invalid codespace name (use the name from gh codespace list): $1"
		;;
	esac
}

validate_timezone() {
	case $1 in
	'' | *[!A-Za-z0-9/_+-]*)
		die "invalid timezone (IANA id like America/Chicago): $1"
		;;
	esac
}

crontab_without_marker() {
	grep -F -v "$MARKER" || true
}

parse_bool() {
	case "$1" in
	true | yes | on | 1) printf '1\n' ;;
	false | no | off | 0 | '') printf '0\n' ;;
	*) die "expected true/false, got $1" ;;
	esac
}

setup_logging() {
	if [ -z "$cfg_log_dir" ]; then
		cfg_log_dir="${XDG_STATE_HOME:-$HOME/.local/state}/codespaces-keepalive"
	fi
	cfg_log_dir=$(expand_path "$cfg_log_dir")
	mkdir -p "$cfg_log_dir" || die "cannot create log_dir $cfg_log_dir"
	log_file="$cfg_log_dir/keepalive.log"
	debug "log_file=$log_file timezone=$cfg_timezone minute=$cfg_minute hours=$cfg_hours weekdays=$cfg_weekdays name=$cfg_name"
}

# hours/weekdays: "*", "n", or "n-m" (inclusive). No lists, steps, or names.
validate_span() {
	spec=$1
	lo=$2
	hi=$3
	kind=$4
	case $spec in
	\*)
		return 0
		;;
	'' | *[!0-9-]* | *-*-*)
		die "$kind: use *, a number, or a range like 7-17 (got $spec)"
		;;
	*-*)
		_start=${spec%%-*}
		_end=${spec#*-}
		if [ -z "$_start" ] || [ -z "$_end" ]; then
			die "$kind: use *, a number, or a range like 7-17 (got $spec)"
		fi
		;;
	*)
		_start=$spec
		_end=$spec
		;;
	esac
	_start=$(unpad "$_start")
	_end=$(unpad "$_end")
	if ! is_int "$_start" || ! is_int "$_end"; then
		die "$kind: use *, a number, or a range like 7-17 (got $spec)"
	fi
	if [ "$kind" = weekdays ]; then
		if [ "$_start" -eq 7 ] || [ "$_end" -eq 7 ]; then
			die "weekdays: use 0 for Sunday (0=Sun ... 6=Sat), not 7"
		fi
	fi
	[ "$_start" -ge "$lo" ] && [ "$_end" -le "$hi" ] && [ "$_start" -le "$_end" ] ||
		die "$kind: $_start-$_end is outside $lo-$hi"
}

span_matches() {
	val=$1
	spec=$2
	case $spec in
	\*) return 0 ;;
	*-*)
		_start=$(unpad "${spec%%-*}")
		_end=$(unpad "${spec#*-}")
		;;
	*)
		_start=$(unpad "$spec")
		_end=$_start
		;;
	esac
	[ "$val" -ge "$_start" ] && [ "$val" -le "$_end" ]
}

validate_policy() {
	cfg_minute=$(unpad "$cfg_minute")
	is_int "$cfg_minute" || die "minute must be 0-59"
	[ "$cfg_minute" -le 59 ] || die "minute must be 0-59"
	validate_span "$cfg_hours" 0 23 hours
	validate_span "$cfg_weekdays" 0 6 weekdays
}

# MIN HOUR DOW — DOW is POSIX %w (0=Sun ... 6=Sat).
policy_matches_at() {
	min=$(unpad "$1")
	hour=$(unpad "$2")
	dow=$(unpad "$3")
	[ "$min" -eq "$cfg_minute" ] || return 1
	span_matches "$hour" "$cfg_hours" || return 1
	span_matches "$dow" "$cfg_weekdays" || return 1
	return 0
}

policy_matches_now() {
	now=$(TZ=$cfg_timezone date '+%M %H %w')
	# Intentional split of `date` fields (MM HH w).
	# shellcheck disable=SC2086
	set -- $now
	policy_matches_at "$1" "$2" "$3"
}

policy_crontab() {
	printf '%s %s * * %s\n' "$cfg_minute" "$cfg_hours" "$cfg_weekdays"
}

strip_quotes() {
	val=$1
	case $val in
	\"*\") val=${val#\"}; val=${val%\"} ;;
	\'*\') val=${val#\'}; val=${val%\'} ;;
	esac
	printf '%s\n' "$val"
}

load_config() {
	path=$1
	[ -f "$path" ] || die "config not found: $path
Copy config.example to that path and set name."
	while IFS= read -r line || [ -n "$line" ]; do
		case $line in
		'' | \#*) continue ;;
		esac
		case $line in
		*=*) ;;
		*) die "invalid config line: $line" ;;
		esac
		key=${line%%=*}
		val=$(strip_quotes "${line#*=}")
		case $key in
		timezone) cfg_timezone=$val ;;
		minute) cfg_minute=$val ;;
		hours) cfg_hours=$val ;;
		weekdays) cfg_weekdays=$val ;;
		schedule) die "schedule= was removed; use minute=, hours=, and weekdays= (see config.example)" ;;
		start_timeout_seconds) cfg_start_timeout_seconds=$val ;;
		heartbeat_command) cfg_heartbeat_command=$val ;;
		name) cfg_name=$val ;;
		log_dir) cfg_log_dir=$val ;;
		debug) cfg_debug=$(parse_bool "$val") ;;
		*) die "unknown config key: $key" ;;
		esac
	done <"$path"
	is_int "$cfg_start_timeout_seconds" || die "start_timeout_seconds must be an integer"
	[ "$cfg_start_timeout_seconds" -ge 1 ] || die "start_timeout_seconds must be >= 1"
	[ -n "$cfg_name" ] || die "config needs name= (the codespace name from gh codespace list)"
	validate_codespace_name "$cfg_name"
	validate_timezone "$cfg_timezone"
	validate_policy
}

require_gh() {
	command -v gh >/dev/null 2>&1 || die "gh is not on PATH; install GitHub CLI and run gh auth login"
}

codespace_state() {
	debug "gh codespace view -c $1 --json state"
	gh codespace view -c "$1" --json state --template '{{.state}}'
}

start_codespace() {
	name=$1
	if [ "$dry_run" = 1 ]; then
		log "$name: would start"
		return 0
	fi
	log "$name: starting"
	debug "POST user/codespaces/$name/start"
	# 409 = already running; treat as success.
	if out=$(gh api --method POST "user/codespaces/${name}/start" 2>&1); then
		debug "start ok"
		return 0
	fi
	case $out in
	*'409'* | *'Conflict'* | *'already'*)
		log "$name: start returned conflict (already up)"
		return 0
		;;
	esac
	printf '%s\n' "$out" >&2
	die "$name: failed to start"
}

heartbeat() {
	name=$1
	if [ "$dry_run" = 1 ]; then
		log "$name: would heartbeat"
		return 0
	fi
	log "$name: heartbeat"
	debug "gh codespace ssh -c $name -- sh -c $(sh_quote "$cfg_heartbeat_command")"
	gh codespace ssh -c "$name" -- sh -c "$cfg_heartbeat_command" </dev/null
}

wait_available() {
	name=$1
	elapsed=0
	while [ "$elapsed" -lt "$cfg_start_timeout_seconds" ]; do
		state=$(codespace_state "$name")
		debug "wait: elapsed=${elapsed}s state=$state"
		case $state in
		Available)
			return 0
			;;
		Starting | Provisioning | Queued | Created | Updating | Rebuilding | Shutdown | Unknown | '')
			;;
		*)
			die "$name: entered state ${state:-unknown}; not waiting"
			;;
		esac
		sleep 10
		elapsed=$((elapsed + 10))
	done
	die "$name: timed out waiting to become Available"
}

ensure_alive() {
	name=$1
	state=$2
	case $state in
	Available)
		heartbeat "$name"
		log "$name: heartbeat sent (state=$state)"
		;;
	Shutdown | Unknown | Starting | Provisioning | Queued | Created)
		if [ "$state" = Shutdown ] || [ "$state" = Unknown ]; then
			start_codespace "$name"
		fi
		if [ "$dry_run" = 1 ]; then
			log "$name: would wait for Available then heartbeat (state=$state)"
			return 0
		fi
		wait_available "$name"
		heartbeat "$name"
		log "$name: started and heartbeat sent (was $state)"
		;;
	*)
		log "$name: skipped (state=$state)"
		;;
	esac
}

cmd_tick() {
	if [ "$force" != 1 ] && ! policy_matches_now; then
		debug "policy miss; noop"
		return 0
	fi
	debug "tick name=$cfg_name force=$force dry_run=$dry_run"
	require_gh
	ensure_alive "$cfg_name" "$(codespace_state "$cfg_name")"
}

cmd_daemon() {
	log "daemon up; checking policy every 60s timezone=$cfg_timezone"
	while true; do
		# die() exits the process; keep the loop alive across a failed tick.
		( cmd_tick ) || true
		sleep 60
	done
}

cmd_status() {
	printf 'config:     %s\n' "$config_path"
	printf 'timezone:   %s\n' "$cfg_timezone"
	printf 'minute:     %s\n' "$cfg_minute"
	printf 'hours:      %s\n' "$cfg_hours"
	printf 'weekdays:   %s\n' "$cfg_weekdays"
	printf 'now:        %s\n' "$(TZ=$cfg_timezone date '+%Y-%m-%d %H:%M:%S %Z')"
	if policy_matches_now; then
		printf 'matches:    yes\n'
	else
		printf 'matches:    no\n'
	fi
	printf 'name:       %s\n' "$cfg_name"
	printf 'debug:      %s\n' "$debug"
	printf 'log_dir:    %s\n' "$cfg_log_dir"
	printf 'log_file:   %s\n' "$log_file"
	require_gh
	gh codespace view -c "$cfg_name" --json name,state,lastUsedAt,repository \
		--template 'state:      {{.state}}
lastUsedAt: {{.lastUsedAt}}
repository: {{.repository}}
'
}

path_prefix() {
	# Snapshot this process's PATH (existing dirs only) so systemd/launchd/cron
	# match the shell that ran `install`. Do not hardcode other OS layouts.
	_out=
	_saved_ifs=$IFS
	set -f
	IFS=:
	# shellcheck disable=SC2086
	set -- $PATH /usr/bin /bin
	IFS=$_saved_ifs
	set +f
	for _dir in "$@"; do
		[ -n "$_dir" ] || continue
		case $_dir in
		/*) ;;
		*) continue ;;
		esac
		[ "$_dir" = / ] && continue
		[ -d "$_dir" ] || continue
		case ":${_out}:" in
		*":${_dir}:"*) continue ;;
		esac
		if [ -n "$_out" ]; then
			_out="${_out}:${_dir}"
		else
			_out=$_dir
		fi
	done
	printf '%s\n' "$_out"
}

cron_line() {
	debug_flag=
	[ "$debug" = 1 ] && debug_flag=' --debug'
	printf '%s\n' "CRON_TZ=${cfg_timezone}  # ${MARKER}"
	printf '%s\n' "$(policy_crontab) PATH=$(path_prefix) $(sh_quote "$(script_path)") --config $(sh_quote "$config_path") tick --force${debug_flag}  # ${MARKER}"
}

cmd_install() {
	target=${1:-}
	case $target in
	cron)
		lines=$(cron_line)
		if [ "$apply" != 1 ]; then
			printf '# print-only (pass --apply to install)\n%s\n' "$lines"
			return 0
		fi
		current=$(crontab -l 2>/dev/null || true)
		kept=$(printf '%s\n' "$current" | crontab_without_marker)
		{
			[ -n "$kept" ] && printf '%s\n' "$kept"
			printf '%s\n' "$lines"
		} | crontab -
		log "installed crontab"
		printf '%s\n' "$lines"
		;;
	systemd)
		unit_dir="${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user"
		service="${unit_dir}/${MARKER}.service"
		timer="${unit_dir}/${MARKER}.timer"
		debug_exec=
		[ "$debug" = 1 ] && debug_exec=' --debug'
		service_body=$(
			cat <<EOF
[Unit]
Description=GitHub Codespaces scheduled keepalive tick
After=network-online.target

[Service]
Type=oneshot
Environment="PATH=$(path_prefix)"
ExecStart="$(script_path)" --config "${config_path}" tick${debug_exec}
EOF
		)
		timer_body=$(
			cat <<EOF
[Unit]
Description=GitHub Codespaces scheduled keepalive

[Timer]
OnCalendar=minutely
Persistent=true
AccuracySec=1s

[Install]
WantedBy=timers.target
EOF
		)
		if [ "$apply" != 1 ]; then
			printf '# print-only (pass --apply to install)\n%s\n\n%s\n' "$service_body" "$timer_body"
			return 0
		fi
		mkdir -p "$unit_dir"
		printf '%s\n' "$service_body" >"$service"
		printf '%s\n' "$timer_body" >"$timer"
		systemctl --user daemon-reload
		systemctl --user enable --now "${MARKER}.timer"
		log "enabled user timer ${MARKER}.timer"
		;;
	launchd)
		plist_path="${HOME}/Library/LaunchAgents/${MARKER}.plist"
		debug_xml=
		if [ "$debug" = 1 ]; then
			debug_xml='    <string>--debug</string>
'
		fi
		plist_body=$(
			cat <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>${MARKER}</string>
  <key>ProgramArguments</key>
  <array>
    <string>$(xml_escape "$(script_path)")</string>
    <string>--config</string>
    <string>$(xml_escape "$config_path")</string>
    <string>tick</string>
${debug_xml}  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>$(xml_escape "$(path_prefix)")</string>
  </dict>
  <key>StartInterval</key>
  <integer>60</integer>
  <key>RunAtLoad</key>
  <true/>
  <key>StandardOutPath</key>
  <string>$(xml_escape "$cfg_log_dir/launchd.stdout.log")</string>
  <key>StandardErrorPath</key>
  <string>$(xml_escape "$cfg_log_dir/launchd.stderr.log")</string>
</dict>
</plist>
EOF
		)
		if [ "$apply" != 1 ]; then
			printf '# print-only (pass --apply to install)\n%s\n' "$plist_body"
			return 0
		fi
		mkdir -p "$(dirname "$plist_path")"
		printf '%s\n' "$plist_body" >"$plist_path"
		launchctl unload "$plist_path" 2>/dev/null || true
		launchctl load "$plist_path"
		log "loaded $plist_path"
		;;
	*)
		die "install target must be cron, systemd, or launchd"
		;;
	esac
}

uninstall_cron() {
	if ! command -v crontab >/dev/null 2>&1; then
		printf '# crontab not found; skip\n'
		return 0
	fi
	current=$(crontab -l 2>/dev/null || true)
	if ! printf '%s\n' "$current" | grep -F -q "$MARKER"; then
		printf '# no crontab lines matching %s\n' "$MARKER"
		return 0
	fi
	if [ "$apply" != 1 ]; then
		printf '# would remove crontab lines matching %s:\n' "$MARKER"
		printf '%s\n' "$current" | grep -F "$MARKER" || true
		return 0
	fi
	kept=$(printf '%s\n' "$current" | crontab_without_marker)
	if [ -z "$kept" ]; then
		crontab -r 2>/dev/null || true
	else
		printf '%s\n' "$kept" | crontab -
	fi
	printf 'removed crontab lines matching %s\n' "$MARKER"
}

uninstall_systemd() {
	unit_dir="${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user"
	service="${unit_dir}/${MARKER}.service"
	timer="${unit_dir}/${MARKER}.timer"
	found=0
	[ -f "$service" ] && found=1
	[ -f "$timer" ] && found=1
	if command -v systemctl >/dev/null 2>&1; then
		if systemctl --user cat "${MARKER}.timer" >/dev/null 2>&1 ||
			systemctl --user cat "${MARKER}.service" >/dev/null 2>&1; then
			found=1
		fi
		if systemctl --user cat codespaces-keepalive.timer >/dev/null 2>&1; then
			printf '# home-manager timer codespaces-keepalive.timer is present; set services.codespaces-keepalive.enable = false instead of uninstalling it here\n'
		fi
	fi
	if [ "$found" != 1 ]; then
		printf '# no systemd user unit %s.{service,timer}\n' "$MARKER"
		return 0
	fi
	if [ "$apply" != 1 ]; then
		printf '# would disable systemd --user %s.timer and remove:\n' "$MARKER"
		[ -f "$service" ] && printf '#   %s\n' "$service"
		[ -f "$timer" ] && printf '#   %s\n' "$timer"
		return 0
	fi
	if command -v systemctl >/dev/null 2>&1; then
		systemctl --user disable --now "${MARKER}.timer" 2>/dev/null || true
		systemctl --user stop "${MARKER}.service" 2>/dev/null || true
	fi
	rm -f "$service" "$timer"
	if command -v systemctl >/dev/null 2>&1; then
		systemctl --user daemon-reload 2>/dev/null || true
		systemctl --user reset-failed "${MARKER}.service" "${MARKER}.timer" 2>/dev/null || true
	fi
	printf 'removed systemd user unit %s\n' "$MARKER"
}

uninstall_launchd() {
	plist_path="${HOME}/Library/LaunchAgents/${MARKER}.plist"
	found=0
	[ -f "$plist_path" ] && found=1
	if command -v launchctl >/dev/null 2>&1; then
		if launchctl list "$MARKER" >/dev/null 2>&1; then
			found=1
		fi
	fi
	if [ "$found" != 1 ]; then
		printf '# no launchd agent %s\n' "$MARKER"
		return 0
	fi
	if [ "$apply" != 1 ]; then
		printf '# would unload launchd agent and remove %s\n' "$plist_path"
		return 0
	fi
	if command -v launchctl >/dev/null 2>&1; then
		launchctl unload "$plist_path" 2>/dev/null || true
		launchctl bootout "gui/$(id -u)/${MARKER}" 2>/dev/null || true
	fi
	rm -f "$plist_path"
	printf 'removed launchd agent %s\n' "$plist_path"
}

cmd_uninstall() {
	target=${1:-all}
	[ -n "$target" ] || target=all
	if [ "$apply" != 1 ]; then
		printf '# print-only (pass --apply to uninstall)\n'
	fi
	case $target in
	all)
		uninstall_cron
		uninstall_systemd
		uninstall_launchd
		;;
	cron) uninstall_cron ;;
	systemd) uninstall_systemd ;;
	launchd) uninstall_launchd ;;
	*) die "uninstall target must be cron, systemd, launchd, or omitted for all" ;;
	esac
	printf '# left in place: config %s, logs, and %s\n' "$config_path" "$(script_path)"
}

# Sourced by tests (KEEPALIVE_LIB=1): skip argument parsing / main.
if [ "${KEEPALIVE_LIB:-}" != 1 ]; then

config_path=$DEFAULT_CONFIG
force=0
dry_run=0
apply=0
cli_debug=0
cli_log_dir=
cmd=
install_target=

while [ $# -gt 0 ]; do
	case $1 in
	-h | --help)
		usage
		exit 0
		;;
	--config)
		[ $# -ge 2 ] || die "--config needs a path"
		config_path=$2
		shift 2
		;;
	--force)
		force=1
		shift
		;;
	--dry-run)
		dry_run=1
		shift
		;;
	-d | --debug)
		cli_debug=1
		shift
		;;
	--log-dir)
		[ $# -ge 2 ] || die "--log-dir needs a path"
		cli_log_dir=$2
		shift 2
		;;
	--apply)
		apply=1
		shift
		;;
	tick | daemon | status | install | uninstall)
		[ -z "$cmd" ] || die "extra command $1"
		cmd=$1
		shift
		;;
	cron | systemd | launchd)
		[ "$cmd" = install ] || [ "$cmd" = uninstall ] || die "unexpected argument $1"
		install_target=$1
		shift
		;;
	*)
		die "unknown argument: $1 (see --help)"
		;;
	esac
done

[ -n "$cmd" ] || {
	usage >&2
	exit 2
}

config_path=$(absolute_path "$config_path")

if [ "$cmd" = uninstall ]; then
	cmd_uninstall "$install_target"
	exit 0
fi

load_config "$config_path"
if [ -n "$cli_log_dir" ]; then
	cfg_log_dir=$cli_log_dir
fi
if [ "$cli_debug" = 1 ] || [ "$cfg_debug" = 1 ]; then
	debug=1
fi
setup_logging

case $cmd in
tick) cmd_tick ;;
daemon) cmd_daemon ;;
status) cmd_status ;;
install) cmd_install "$install_target" ;;
*) die "unknown command: $cmd" ;;
esac

fi
