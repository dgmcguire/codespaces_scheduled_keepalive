# Copy to ~/.config/codespaces-keepalive/config
#
#   mkdir -p ~/.config/codespaces-keepalive
#   cp config.example ~/.config/codespaces-keepalive/config
#
# Codespace name from `gh codespace list` (gh is already authenticated).

name=your-codespace-name

# IANA timezone used to evaluate `schedule`. install cron also sets CRON_TZ.
timezone=America/Chicago

# 5-field crontab: minute hour day-of-month month weekday
#   weekday: 0 or 7 = Sun, 1 = Mon ... 6 = Sat (names like mon-fri also work)
# Idle timeout is 2 hours, so once an hour is enough.
# This fires at :00 from 07:00 through 17:00, Monday-Friday.
schedule=0 7-17 * * 1-5

# Seconds to wait after start for the codespace to become Available.
start_timeout_seconds=300

# Run over `gh codespace ssh` so GitHub records activity.
heartbeat_command=true

# Directory for keepalive.log (created if missing). ~ is expanded.
# Default: $XDG_STATE_HOME/codespaces-keepalive (usually ~/.local/state/...).
# log_dir=~/.local/state/codespaces-keepalive

# Extra schedule/gh traces in keepalive.log. Also --debug on the CLI.
debug=false
